{
  "name": "bhairava-kali-calendar",
  "version": "2.0.0",
  "description": "Bhairava Baba and Ma Adya Mahakali Upasana Calendar — static site with .ics export",
  "scripts": {
    "dev": "serve . -l 3000",
    "test": "node --test test/app.test.js test/generate_events.test.js",
    "test:syntax": "node test/check-syntax.js",
    "test:browser": "playwright test",
    "serve:test": "serve . -l 42317 --no-clipboard",
    "validate": "npm run test:syntax && npm test && npm run test:browser",
    "generate": "node generate_events.js",
    "deploy": "npx wrangler pages deploy ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.59.1",
    "serve": "^14.2.4"
  },
  "keywords": [
    "bhairava",
    "kali",
    "upasana",
    "calendar",
    "navaratri",
    "ics"
  ],
  "author": "Ashish Kapoor",
  "license": "MIT"
}
